[Unit]
Description=fpager: Flipper Zero pager daemon
Documentation=https://github.com/ernado/flipper-notify
After=bluetooth.target

[Service]
# FPAGER_MAC=..., optionally FPAGER_TRANSPORT / FPAGER_USB.
EnvironmentFile=-%h/.config/fpager/env
ExecStart=%h/.local/bin/fpager daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
